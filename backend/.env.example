# =====================================================================
# Configuración del Backend - Plantilla de Entorno (.env.example)
# Copia este archivo como .env y añade tus claves reales.
# NUNCA subas el archivo .env real al repositorio de Git.
# =====================================================================

# Clave de API de Google GenAI (Gemini 1.5 Flash)
GEMINI_API_KEY=tu_clave_de_gemini_aqui

# Puerto y Host del Servidor FastAPI
PORT=8000
HOST=0.0.0.0

# Nivel de Privacidad Diferencial (Epsilon)
DP_EPSILON=1.0

# Directorio de Almacenamiento Local de Evidencia y Reportes
DATA_DIR=data
